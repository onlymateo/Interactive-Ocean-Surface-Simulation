# Simulation settings. One key=value per line. Lines starting with # are ignored.

# Window size in pixels
width=800
height=600

# Wave method: gerstner, perlin or fft
method=gerstner

# number of cells in the plane grid
cellsnumber=20

# Width and depth of the plane, in world units
planesize=100.0

# Camera: a perspective view looking at the origin, with the plane tilted towards the viewer
nearplane=0.2
farplane=1000.0

# controls how wide the view is
halfheightatnear=0.1

# how far the plane is pushed away from the viewer
cameradistance=-100.0

# rotation around the x axis
tiltdegrees=-60.0
